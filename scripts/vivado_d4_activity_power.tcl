# Activity-driven power annotation for the routed independent D4 full-net top.
# This script analyzes an existing routed checkpoint; it does not implement or
# alter the design. The companion converter emits SAIF rooted at the requested
# target scope, so read_saif must retain that hierarchy.

if {[llength $argv] < 4 || [llength $argv] > 5} {
    error "usage: vivado -mode batch -source vivado_d4_activity_power.tcl -tclargs <routed.dcp> <activity.saif> <output_dir> <target_scope> ?<hierarchy_binding.tsv>?"
}
lassign $argv checkpoint saif output_dir target_scope
set hierarchy_binding_file {}
if {[llength $argv] == 5} { set hierarchy_binding_file [lindex $argv 4] }
set checkpoint [file normalize $checkpoint]
set saif [file normalize $saif]
set output_dir [file normalize $output_dir]
if {![file isfile $checkpoint]} { error "checkpoint does not exist: $checkpoint" }
if {![file isfile $saif]} { error "SAIF does not exist: $saif" }
if {![file isdirectory $output_dir]} { error "output directory does not exist: $output_dir" }

# Synthesis often replaces a register bus net with <name>_reg_n_0_... .
# Preserve provenance by aliasing only exact original-name FD* Q points;
# never guess DSP bit slices, retimed/replicated names, or recoded FSM state.
proc d4_saif_atom {name} {
    if {$name eq {} || [string first "\n" $name] >= 0 || [string first "\r" $name] >= 0} {
        error "cannot represent empty or multiline SAIF identifier"
    }
    if {[regexp {\s} $name]} {
        error "cannot represent whitespace in a SAIF identifier"
    }
    # SAIF identifiers use backslash escapes for literal punctuation. Double-
    # quoted strings are not legal INSTANCE/NET identifiers in Vivado SAIF.
    # Keep a final numeric bus index in SAIF's native [n] form and escape every
    # special character in the remaining literal name (including physical dots).
    set prefix $name
    set suffix {}
    if {[regexp {^(.+)(\[[0-9]+\])$} $name -> parsed_prefix parsed_suffix]} {
        set prefix $parsed_prefix
        set suffix $parsed_suffix
    }
    set escaped {}
    set index 0
    foreach char [split $prefix {}] {
        if {[regexp {^[A-Za-z0-9_]$} $char] && !($index == 0 && [string is digit -strict $char])} {
            append escaped $char
        } else {
            append escaped "\\" $char
        }
        incr index
    }
    append escaped $suffix
    return $escaped
}

proc d4_saif_string {value} {
    if {[string first "\n" $value] >= 0 || [string first "\r" $value] >= 0} {
        error "cannot represent multiline SAIF string"
    }
    set escaped [string map [list "\\" "\\\\" "\"" "\\\""] $value]
    return "\"$escaped\""
}

proc d4_write_saif_instance {fh name node indent} {
    set pad [string repeat " " $indent]
    puts $fh [format "%s(INSTANCE %s" $pad [d4_saif_atom $name]]
    set nets [dict get $node __nets]
    if {[dict size $nets]} {
        puts $fh "$pad  (NET"
        foreach net_name [lsort [dict keys $nets]] {
            lassign [dict get $nets $net_name] t0 t1 tx tz tc
            puts $fh "$pad    ([d4_saif_atom $net_name] (T0 $t0) (T1 $t1) (TX $tx) (TZ $tz) (TC $tc))"
        }
        puts $fh "$pad  )"
    }
    set instances [dict get $node __instances]
    foreach child_name [lsort [dict keys $instances]] {
        d4_write_saif_instance $fh $child_name [dict get $instances $child_name] [expr {$indent + 2}]
    }
    puts $fh "$pad)"
}

proc d4_write_fd_q_alias_saif {path design_top timescale_factor timescale_unit duration q_stats} {
    set root [dict create __instances [dict create] __nets [dict create]]
    dict for {net value} $q_stats {
        lassign $value rtl_name physical_name stats
        set segments [split $physical_name "/"]
        if {[lindex $segments 0] eq $design_top} { set segments [lrange $segments 1 end] }
        if {![llength $segments]} { error "empty physical net path for $rtl_name" }
        foreach segment $segments {
            if {$segment eq {}} { error "empty physical net path component for $rtl_name" }
        }
        set node_path {}
        foreach instance_name [lrange $segments 0 end-1] {
            lappend node_path __instances $instance_name
            if {![dict exists $root {*}$node_path]} {
                dict set root {*}$node_path [dict create __instances [dict create] __nets [dict create]]
            }
        }
        lappend node_path __nets [lindex $segments end]
        dict set root {*}$node_path $stats
    }
    set fh [open $path w]
    puts $fh "(SAIFILE"
    puts $fh { (SAIFVERSION "2.0")}
    puts $fh { (DIRECTION "backward")}
    puts $fh " (DESIGN [d4_saif_string $design_top])"
    puts $fh { (DATE "generated by vivado_d4_activity_power.tcl")}
    puts $fh { (VENDOR "OpenAI Codex local tooling")}
    puts $fh { (PROGRAM_NAME "vivado_d4_activity_power.tcl")}
    puts $fh { (VERSION "1.0")}
    puts $fh " (DIVIDER /)"
    puts $fh " (TIMESCALE $timescale_factor $timescale_unit)"
    puts $fh " (DURATION $duration)"
    d4_write_saif_instance $fh $design_top $root 1
    puts $fh ")"
    close $fh
}

proc d4_saif_port_record {line} {
    if {![regexp {^\(([A-Za-z_][A-Za-z0-9_$\[\]:-]*) \(T0 ([0-9]+)\) \(T1 ([0-9]+)\) \(TX ([0-9]+)\) \(TZ ([0-9]+)\) \(TC ([0-9]+)\)\)$} $line -> name t0 t1 tx tz tc]} {
        error "Malformed top-level SAIF PORT record: $line"
    }
    return [list $name [list $t0 $t1 $tx $tz $tc]]
}

proc d4_tsv_value {value} {
    return [string map [list "\t" " " "\n" " " "\r" " "] $value]
}

proc d4_apply_top_input_activity {path ports port_stats duration duration_seconds} {
    set source_records [dict size $port_stats]
    set exact_candidates 0
    set input_candidates 0
    set applied 0
    set unmatched 0
    set clock_excluded 0
    set non_input_excluded 0
    set unknown_skipped 0
    set fh [open $path w]
    puts $fh "port_name\texact_design_port_match\tdirection\tclock\tT0\tT1\tTX\tTZ\tTC\tduration_seconds\tstatic_probability\tsignal_rate_mtransitions_per_s\tset_switching_activity\treason"
    foreach name [lsort [dict keys $port_stats]] {
        set stats [dict get $port_stats $name]
        lassign $stats t0 t1 tx tz tc
        set matched 0
        set direction UNMATCHED
        set is_clock 0
        set probability {}
        set signal_rate {}
        set assigned 0
        set reason no_exact_design_port_name
        if {![dict exists $ports $name]} {
            incr unmatched
        } else {
            incr exact_candidates
            set matched 1
            set port [dict get $ports $name]
            set direction [string toupper [get_property DIRECTION $port]]
            if {$direction ni {IN OUT INOUT}} {
                error "Unsupported Vivado direction '$direction' for top-level port $name"
            }
            if {[llength [get_clocks -quiet -of_objects $port]]} {
                incr clock_excluded
                set is_clock 1
                set reason clock_port_excluded
            } elseif {$direction ne {IN}} {
                incr non_input_excluded
                set reason non_input_port_excluded
            } else {
                incr input_candidates
                if {$tx != 0 || $tz != 0} {
                    incr unknown_skipped
                    set reason unknown_state_residency_skipped
                } else {
                    if {$t0 + $t1 != $duration} {
                        error "Known-state SAIF residency for port $name does not equal DURATION"
                    }
                    set probability [format %.17g [expr {double($t1) / double($duration)}]]
                    set signal_rate [format %.17g [expr {double($tc) / $duration_seconds / 1000000.0}]]
                    # Vivado -signal_rate takes absolute Mtransitions/s. Do not
                    # convert to a clock-relative toggle rate or clamp the data.
                    set_switching_activity -signal_rate $signal_rate -static_probability $probability $port
                    incr applied
                    set assigned 1
                    set reason explicit_saif_statistics_applied
                }
            }
        }
        puts $fh "[d4_tsv_value $name]\t$matched\t$direction\t$is_clock\t$t0\t$t1\t$tx\t$tz\t$tc\t[format %.17g $duration_seconds]\t$probability\t$signal_rate\t$assigned\t$reason"
    }
    close $fh
    return [dict create \
        source_top_level_port_records $source_records \
        exact_design_port_name_candidates $exact_candidates \
        top_level_nonclock_input_candidates $input_candidates \
        explicit_set_switching_activity_assignments $applied \
        unmatched_top_level_port_records $unmatched \
        clock_ports_excluded $clock_excluded \
        non_input_ports_excluded $non_input_excluded \
        unknown_activity_input_ports_skipped $unknown_skipped \
        port_activity_units Mtransitions_per_second \
        port_activity_rate_formula {TC / (duration_seconds * 1e6)} \
        port_activity_probability_formula {T1 / DURATION for fully known residency}]
}

proc d4_fd_q_binding_expected_rows {} {
    set expected [dict create]
    for {set lane 0} {$lane < 16} {incr lane} {
        set source_scope "u_core/rq_mul_lanes\[$lane\]/rq_mul"
        set physical_scope "u_core/rq_mul_lanes\[$lane\].rq_mul"
        dict set expected $source_scope [list $physical_scope d4_rq_partial_multiplier_lane u_core]
    }
    return $expected
}

proc d4_binding_scopes_overlap {left right} {
    if {$left eq $right} { return 1 }
    return [expr {
        [string first "$left/" $right] == 0 ||
        [string first "$right/" $left] == 0
    }]
}

proc d4_read_fd_q_hierarchy_bindings {path} {
    if {$path eq {}} { return [dict create] }
    if {![file isfile $path]} { error "FD-Q hierarchy binding TSV does not exist: $path" }
    set fh [open $path r]
    set content [read $fh]
    close $fh
    if {[string index $content end] eq "\n"} {
        set content [string range $content 0 end-1]
    }
    if {$content eq {}} { error "FD-Q hierarchy binding TSV is empty" }
    set lines [split $content "\n"]
    set header [string trimright [lindex $lines 0] "\r"]
    if {[string index $header 0] eq "\ufeff"} {
        set header [string range $header 1 end]
    }
    if {$header ne "source_scope\tphysical_scope\texpected_orig_ref\texpected_parent"} {
        error "FD-Q hierarchy binding TSV header must be source_scope, physical_scope, expected_orig_ref, expected_parent"
    }

    set rows [dict create]
    set physical_seen [dict create]
    set source_scopes {}
    set physical_scopes {}
    foreach line [lrange $lines 1 end] {
        set line [string trimright $line "\r"]
        if {$line eq {}} { error "FD-Q hierarchy binding TSV contains an empty row" }
        set fields [split $line "\t"]
        if {[llength $fields] != 4} {
            error "Malformed FD-Q hierarchy binding row: expected four TSV fields"
        }
        lassign $fields source_scope physical_scope expected_orig_ref expected_parent
        if {$source_scope eq {} || $physical_scope eq {} || $expected_orig_ref eq {} || $expected_parent eq {}} {
            error "Malformed FD-Q hierarchy binding row: fields must be non-empty"
        }
        if {[dict exists $rows $source_scope]} {
            error "Duplicate FD-Q source scope in hierarchy binding TSV: $source_scope"
        }
        if {[dict exists $physical_seen $physical_scope]} {
            error "Duplicate FD-Q physical scope in hierarchy binding TSV: $physical_scope"
        }
        dict set rows $source_scope [list $physical_scope $expected_orig_ref $expected_parent]
        dict set physical_seen $physical_scope 1
        lappend source_scopes $source_scope
        lappend physical_scopes $physical_scope
    }

    for {set i 0} {$i < [llength $source_scopes]} {incr i} {
        for {set j [expr {$i + 1}]} {$j < [llength $source_scopes]} {incr j} {
            set source_left [lindex $source_scopes $i]
            set source_right [lindex $source_scopes $j]
            if {[d4_binding_scopes_overlap $source_left $source_right]} {
                error "Overlapping FD-Q source scopes in hierarchy binding TSV: $source_left and $source_right"
            }
            set physical_left [lindex $physical_scopes $i]
            set physical_right [lindex $physical_scopes $j]
            if {[d4_binding_scopes_overlap $physical_left $physical_right]} {
                error "Overlapping FD-Q physical scopes in hierarchy binding TSV: $physical_left and $physical_right"
            }
        }
    }

    set expected [d4_fd_q_binding_expected_rows]
    if {[dict size $rows] != [dict size $expected]} {
        error "FD-Q hierarchy binding TSV must contain all 16 enumerated L2 RQ scopes; got [dict size $rows]"
    }
    dict for {source_scope expected_values} $expected {
        if {![dict exists $rows $source_scope]} {
            error "Missing enumerated FD-Q source scope in hierarchy binding TSV: $source_scope"
        }
        if {[dict get $rows $source_scope] ne $expected_values} {
            error "FD-Q hierarchy binding row disagrees with enumerated L2 evidence: $source_scope"
        }
    }
    return $rows
}

proc d4_validate_fd_q_hierarchy_bindings {rows output_dir} {
    set report_path [file join $output_dir fd_q_hierarchy_binding_validation.tsv]
    set report [open $report_path w]
    puts $report "source_scope\tphysical_scope\texpected_orig_ref\texpected_parent\tmatched_name\tactual_orig_ref\tactual_parent\tvalidation"
    set candidate_cells [get_cells -quiet -hier -filter {ORIG_REF_NAME == d4_rq_partial_multiplier_lane}]
    dict for {source_scope values} $rows {
        lassign $values physical_scope expected_orig_ref expected_parent
        set matches {}
        foreach cell $candidate_cells {
            if {[get_property NAME $cell] eq $physical_scope} { lappend matches $cell }
        }
        if {[llength $matches] != 1} {
            puts $report "$source_scope\t$physical_scope\t$expected_orig_ref\t$expected_parent\t\t\t\tREJECTED_NAME_MATCH_COUNT_[llength $matches]"
            close $report
            error "FD-Q hierarchy binding expected exactly one current checkpoint cell NAME $physical_scope; found [llength $matches]"
        }
        set cell [lindex $matches 0]
        set actual_name [get_property NAME $cell]
        set actual_orig_ref [get_property ORIG_REF_NAME $cell]
        set raw_parent [get_property PARENT $cell]
        set actual_parent $raw_parent
        if {$actual_parent ne $expected_parent} {
            if {![catch {set resolved_parent [get_property NAME $raw_parent]}]} {
                set actual_parent $resolved_parent
            }
        }
        if {$actual_name ne $physical_scope || $actual_orig_ref ne $expected_orig_ref || $actual_parent ne $expected_parent} {
            puts $report "$source_scope\t$physical_scope\t$expected_orig_ref\t$expected_parent\t$actual_name\t$actual_orig_ref\t$actual_parent\tREJECTED_NATIVE_PROPERTY_MISMATCH"
            close $report
            error "FD-Q hierarchy binding native property mismatch for $physical_scope: NAME='$actual_name' ORIG_REF_NAME='$actual_orig_ref' PARENT='$actual_parent'"
        }
        puts $report "$source_scope\t$physical_scope\t$expected_orig_ref\t$expected_parent\t$actual_name\t$actual_orig_ref\t$actual_parent\tPASS"
    }
    close $report
    return $report_path
}

proc d4_map_fd_q_physical_scope_to_source {physical_name rows} {
    set matched_source {}
    set matched_prefix {}
    dict for {source_scope values} $rows {
        set physical_scope [lindex $values 0]
        set prefix "${physical_scope}/"
        if {[string first $prefix $physical_name] == 0} {
            if {$matched_source ne {}} {
                error "Ambiguous explicit FD-Q hierarchy prefix for physical cell NAME $physical_name"
            }
            set matched_source $source_scope
            set matched_prefix $prefix
        }
    }
    if {$matched_source eq {}} { return $physical_name }
    set suffix [string range $physical_name [string length $matched_prefix] end]
    return "${matched_source}/${suffix}"
}

proc d4_prepare_fd_q_alias_saif {saif output_dir design_top {binding_file {}}} {
    set binding_rows [d4_read_fd_q_hierarchy_bindings $binding_file]
    if {$binding_file ne {}} {
        set binding_validation_report [d4_validate_fd_q_hierarchy_bindings $binding_rows $output_dir]
    }
    set aliases [dict create]
    foreach cell [get_cells -hier -filter {REF_NAME =~ FD*}] {
        set cname [get_property NAME $cell]
        set cname [d4_map_fd_q_physical_scope_to_source $cname $binding_rows]
        if {![regexp {^(.*)_reg((?:\[[0-9]+\])*)$} $cname -> stem indices]} { continue }
        if {[lindex [split $stem /] end] eq "state"} { continue }
        set q [get_pins -quiet -of_objects $cell -filter {REF_PIN_NAME == Q}]
        set nets [get_nets -quiet -of_objects $q]
        if {[llength $q] != 1 || [llength $nets] != 1} { continue }
        dict set aliases ${stem}${indices} [lindex $nets 0]
    }
    set ports [dict create]
    foreach port [get_ports] { dict set ports [get_property NAME $port] $port }
    set stack {}; set block {}; set duration -1; set duration_seen 0
    set timescale_factor 0; set timescale_unit {}; set timescale_seen 0
    set port_stats [dict create]; set q_stats [dict create]; set conflicts [dict create]
    set saif_records 0; set known_records 0; set unknown_statistics 0
    set net_records_without_exact_fd_q_alias 0
    set units [dict create fs 1e-15 ps 1e-12 ns 1e-9 us 1e-6 ms 1e-3 s 1.0]
    set fh [open $saif r]
    while {[gets $fh line] >= 0} {
        set line [string trim $line]
        if {[regexp {^\(TIMESCALE ([0-9]+) ([a-z]+)\)$} $line -> factor unit]} {
            if {$timescale_seen} { error "Duplicate SAIF TIMESCALE declaration" }
            if {![dict exists $units $unit]} { error "Unsupported SAIF TIMESCALE unit: $unit" }
            if {$factor <= 0} { error "SAIF TIMESCALE factor must be positive" }
            set timescale_factor $factor; set timescale_unit $unit; set timescale_seen 1
            continue
        }
        if {[regexp {^\(DURATION ([0-9]+)\)$} $line -> parsed_duration]} {
            if {$duration_seen} { error "Duplicate SAIF DURATION declaration" }
            if {$parsed_duration <= 0} { error "SAIF DURATION must be positive" }
            set duration $parsed_duration; set duration_seen 1
            continue
        }
        if {[string match {(INSTANCE*} $line]} {
            # Match the converter's exact hierarchy atoms, including generated
            # array scopes such as rq_mul_lanes[0]. Keep each INSTANCE as its
            # own stack entry; do not fold a dotted Vivado name into this path.
            if {$block ne {}} {
                error "Malformed SAIF INSTANCE record inside $block block: $line"
            }
            if {![regexp {^\(INSTANCE ([A-Za-z_][A-Za-z0-9_$:-]*(?:\[[0-9]+\])*)$} $line -> instance]} {
                error "Malformed SAIF INSTANCE record: $line"
            }
            lappend stack $instance; set block {}; continue
        }
        if {[regexp {^\((PORT|NET)$} $line -> block_type]} { set block $block_type; continue }
        if {$line eq ")"} {
            if {$block ne {}} { set block {} } elseif {[llength $stack]} { set stack [lrange $stack 0 end-1] }
            continue
        }
        if {[lindex $stack 0] ne $design_top} { continue }
        set record_type $block
        set record_line $line
        if {$record_type eq {}} {
            # The original packed-trace SAIF writes one record per line as
            # (NET name (T0 ...) ...), while the converter also emits grouped
            # (NET ... ) blocks. Accept both native SAIF layouts.
            if {![regexp {^\((PORT|NET) (.+)\)$} $line -> record_type record_body]} { continue }
            if {[string index $record_body 0] eq "("} {
                set record_line $record_body
            } else {
                set record_line "($record_body)"
            }
        }
        if {![regexp {^\(([A-Za-z_][A-Za-z0-9_$\[\]:-]*) \(T0 ([0-9]+)\) \(T1 ([0-9]+)\) \(TX ([0-9]+)\) \(TZ ([0-9]+)\) \(TC ([0-9]+)\)\)$} $record_line -> name t0 t1 tx tz tc]} {
            if {$record_type eq {PORT} && [llength $stack] == 1} {
                error "Malformed top-level SAIF PORT record: $record_line"
            }
            continue
        }
        incr saif_records
        if {$tx == 0 && $tz == 0 && $t0+$t1 == $duration} { incr known_records } else { incr unknown_statistics }
        set stats [list $t0 $t1 $tx $tz $tc]
        if {$record_type eq {PORT} && [llength $stack] == 1} {
            if {$t0 + $t1 + $tx + $tz != $duration} {
                error "SAIF PORT residency for $name does not equal DURATION"
            }
            lassign [d4_saif_port_record $record_line] port_name port_values
            if {[dict exists $port_stats $port_name]} {
                error "Duplicate top-level SAIF PORT record: $port_name"
            }
            dict set port_stats $port_name $port_values
        }
        set rtl_name [join [concat [lrange $stack 1 end] [list $name]] /]
        if {$record_type ne "NET"} { continue }
        if {![dict exists $aliases $rtl_name]} {
            incr net_records_without_exact_fd_q_alias
            continue
        }
        set net [dict get $aliases $rtl_name]
        if {[dict exists $conflicts $net]} { continue }
        if {[dict exists $q_stats $net] && [lindex [dict get $q_stats $net] 2] ne $stats} {
            dict unset q_stats $net; dict set conflicts $net 1
        } elseif {![dict exists $q_stats $net]} {
            dict set q_stats $net [list $rtl_name [get_property NAME $net] $stats]
        }
    }
    close $fh
    if {!$duration_seen || !$timescale_seen || $timescale_factor <= 0 || ![dict exists $units $timescale_unit]} {
        error "Invalid SAIF duration/timescale for alias import"
    }
    set duration_seconds [expr {double($duration) * double($timescale_factor) * [dict get $units $timescale_unit]}]
    if {$duration_seconds <= 0.0} { error "SAIF duration in seconds must be positive" }
    set port_activity [d4_apply_top_input_activity \
        [file join $output_dir top_level_port_activity_assignments.tsv] \
        $ports $port_stats $duration $duration_seconds]
    set alias_saif [file join $output_dir fd_q_alias.saif]
    d4_write_fd_q_alias_saif $alias_saif $design_top $timescale_factor $timescale_unit $duration $q_stats
    set report [open [file join $output_dir fd_q_alias_points.tsv] w]
    puts $report "source_rtl_bit\tphysical_object\tT0\tT1\tTX\tTZ\tTC"
    dict for {net value} $q_stats {
        lassign $value rtl_name physical_name stats
        puts $report "[string map [list \t " " \n " " \r " "] $rtl_name]\t[string map [list \t " " \n " " \r " "] $physical_name]\t[join $stats \t]"
    }
    close $report
    set summary [open [file join $output_dir fd_q_alias_summary.txt] w]
    puts $summary "saif_activity_records_under_design_top=$saif_records"
    puts $summary "known_statistics_records=$known_records"
    puts $summary "records_with_unknown_statistics_preserved_in_source_saif=$unknown_statistics"
    dict for {key value} $port_activity { puts $summary "$key=$value" }
    puts $summary "exact_FD_Q_physical_name_alias_records=[dict size $q_stats]"
    puts $summary "NET_records_without_exact_FD_Q_alias=$net_records_without_exact_fd_q_alias"
    puts $summary "conflicting_FD_Q_aliases_excluded=[dict size $conflicts]"
    puts $summary "FSM_state_DSP_slices_retimed_and_replica_names=not_inferred"
    puts $summary "alias_saif=fd_q_alias.saif"
    puts $summary "alias_statistics=T0/T1/TX/TZ/TC copied unchanged from source SAIF"
    puts $summary "alias_physical_names=exact Vivado NAME of matched FD Q net"
    puts $summary "alias_saif_import=separate single read_saif; coverage reported separately"
    puts $summary "port_activity_assignment=explicit set_switching_activity on exact nonclock INPUT ports with fully known source SAIF T0/T1/TC"
    puts $summary "port_activity_statistics=T0/T1/TX/TZ/TC checked against DURATION; unknown residency is skipped, never fabricated"
    if {$binding_file ne {}} {
        puts $summary "explicit_hierarchy_binding=enabled"
        puts $summary "explicit_hierarchy_binding_rows=[dict size $binding_rows]"
        puts $summary "explicit_hierarchy_binding_method=enumerated physical-scope prefix followed by slash maps to source-scope prefix"
        puts $summary "explicit_hierarchy_binding_validation_report=[file tail $binding_validation_report]"
    }
    close $summary
    return $alias_saif
}
open_checkpoint $checkpoint
set design [current_design]
set design_name [get_property NAME $design]
set design_top [get_property TOP $design]
if {$design_top ne "d4_fullnet_impl_top"} {
    error "expected checkpoint TOP d4_fullnet_impl_top, got $design_top (design object NAME is $design_name)"
}
set target_parts [split $target_scope "."]
if {[lindex $target_parts 0] ne $design_top} {
    error "SAIF target scope must begin with checkpoint TOP $design_top, got $target_scope"
}
set core_cell [get_cells -quiet -hier -filter {NAME == "u_core"}]
if {[llength $core_cell] != 1} {
    error "expected exactly one top-level u_core cell in checkpoint, found [llength $core_cell]"
}
set core_ref [get_property REF_NAME $core_cell]
if {$core_ref ne "d4_fullnet_top"} {
    error "expected u_core reference d4_fullnet_top, got $core_ref"
}

set route_report [file join $output_dir route_status_input_checkpoint.txt]
report_route_status -file $route_report
report_timing -delay_type max -from [all_registers] -to [all_registers] \
    -max_paths 20 -file [file join $output_dir internal_setup_input_checkpoint.txt]
report_clocks -file [file join $output_dir clocks_input_checkpoint.txt]
foreach {stage pattern} {rq_round *rq_value_reg*/D mac_product *product_reg*/D mac_accum *accum_reg*/D feature_address *features_reg*/ADDR*} {
    set endpoints [get_pins -quiet -hier -filter "NAME =~ $pattern"]
    if {[llength $endpoints]} {
        report_timing -delay_type max -max_paths 1 -to $endpoints \
            -file [file join $output_dir timing_stage_${stage}.txt]
    }
}

# The SAIF target scope is supplied by the wrapper. Preserve its hierarchy so
# the activity lands on the matching routed scope rather than being flattened.
set annotation_report [file join $output_dir saif_annotation_messages.txt]
read_saif -strip_path $design_top -out_file $annotation_report $saif
set alias_saif [d4_prepare_fd_q_alias_saif $saif $output_dir $design_top $hierarchy_binding_file]
set alias_annotation_report [file join $output_dir fd_q_alias_annotation_messages.txt]
read_saif -strip_path $design_top -out_file $alias_annotation_report $alias_saif

# These reports retain the tool's mapped/default activity summary and its
# confidence classification. The import report lists nets that did not map.
report_switching_activity -file [file join $output_dir switching_activity_after_saif.txt] [get_nets -hier]
report_power -file [file join $output_dir power_after_saif_annotation.txt]

set evidence [open [file join $output_dir activity_annotation_scope.txt] w]
puts $evidence "checkpoint=[file tail $checkpoint]"
puts $evidence "design_object_name=$design_name"
puts $evidence "design_top=$design_top"
puts $evidence "core_cell=u_core"
puts $evidence "core_ref=$core_ref"
puts $evidence "saif_target_scope=$target_scope"
puts $evidence "saif=[file tail $saif]"
puts $evidence "annotation_command=read_saif -strip_path $design_top"
puts $evidence "saif_hierarchy_policy=full implementation hierarchy retained"
puts $evidence "activity_source=simulation VCD converted to SAIF"
puts $evidence "original_saif_annotation_report=saif_annotation_messages.txt"
puts $evidence "fd_q_alias_saif=[file tail $alias_saif]"
puts $evidence "fd_q_alias_annotation_report=fd_q_alias_annotation_messages.txt"
puts $evidence "fd_q_alias_statistics=T0/T1/TX/TZ/TC copied unchanged"
puts $evidence "top_level_port_activity_assignment_report=top_level_port_activity_assignments.tsv"
puts $evidence "top_level_port_activity_method=set_switching_activity -signal_rate TC/(duration_seconds*1e6) Mtransitions/s -static_probability T1/DURATION"
puts $evidence "top_level_port_activity_scope=exact matched nonclock INPUT ports with fully known SAIF residency; clocks, outputs, inouts, unmatched, and unknown-state inputs are excluded"
puts $evidence "power_report=power_after_saif_annotation.txt"
puts $evidence "switching_report=switching_activity_after_saif.txt"
puts $evidence "unmatched_activity_report=saif_annotation_messages.txt"
puts $evidence "unannotated_nets=Vivado may use vectorless propagation; inspect switching and power reports"
puts $evidence "power_analysis=Vivado estimate after SAIF import; not every net is guaranteed SAIF annotated"
puts $evidence "annotation_coverage=reported by read_saif annotation messages and switching-activity report; SAIF bit-entry count is not routed-net coverage"
puts $evidence "fd_q_alias_method=exact source RTL FD Q aliases mapped to physical Vivado NAMEs; see fd_q_alias_points.tsv"
puts $evidence "coverage_policy=original and fd_q alias read_saif match counts are separate and not summed"
puts $evidence "measurement_scope=Vivado post-implementation estimate; not board-measured power"
close $evidence

close_design
exit
