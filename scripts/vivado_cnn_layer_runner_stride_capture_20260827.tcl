# Standalone XC7Z020 8 ns post-route screen for the tiled-input stride cone.
# This is runner OOC only; it intentionally does not build cnn_top.
set root [file normalize [file join [file dirname [info script]] ..]]
set out_name vivado_cnn_layer_runner_stride_capture_20260827
if {[info exists ::env(RUNNER_OOC_OUT)]} { set out_name $::env(RUNNER_OOC_OUT) }
set out [file normalize [file join $root build reports $out_name]]
file mkdir $out
set part xc7z020clg400-1
set files [list \
    rtl/common/round_shift.v rtl/common/saturate_int8.v rtl/common/requant_activation_core.v \
    rtl/cnn/requant_activation_unit.v rtl/cnn/requant_activation_pipeline.v \
    rtl/cnn/requant_product_pipeline.v rtl/cnn/requant_activation_vector4.v \
    rtl/cnn/requant_activation_stream4.v rtl/cnn/systolic_pe.v \
    rtl/cnn/pw_systolic_array_8x8.v rtl/cnn/dw_line_buffer.v rtl/cnn/dw_mac_lanes.v \
    rtl/cnn/dw_tile_buffer_bram.v rtl/cnn/ds_input_tile_buffer_bram.v \
    rtl/cnn/pw_weight_buffer_bram.v rtl/cnn/dw_tile_fusion_engine_new.v \
    rtl/cnn/dw_tile_fusion_engine_vector4.v rtl/cnn/ds_block_tile_engine_new.v \
    rtl/cnn/conv3x3_stem_engine_new.v rtl/cnn/gap_unit_new.v rtl/cnn/fc_unit_new.v \
    rtl/cnn/tile_scheduler.v rtl/cnn/feature_sram_bank.v rtl/cnn/feature_sram_pingpong.v \
    rtl/cnn/status_counter.v rtl/cnn/descriptor_fetch.v rtl/cnn/cnn_layer_runner.v]
foreach f $files { read_verilog -sv [file join $root $f] }

synth_design -top cnn_layer_runner -part $part \
    -flatten_hierarchy none -mode out_of_context -directive RuntimeOptimized
create_clock -name clk -period 8.000 [get_ports clk]
opt_design
place_design
phys_opt_design
route_design

report_timing_summary -delay_type max -file [file join $out timing_summary_post_route.txt]
report_timing_summary -delay_type min -file [file join $out timing_hold_summary_post_route.txt]
report_timing -delay_type max -from [all_registers] -to [all_registers] \
    -max_paths 200 -file [file join $out reg_to_reg_maxpaths.txt]
report_timing -delay_type min -from [all_registers] -to [all_registers] \
    -max_paths 200 -file [file join $out reg_to_reg_minpaths.txt]
report_utilization -file [file join $out utilization_post_route.txt]
report_utilization -hierarchical -file [file join $out utilization_hierarchical_post_route.txt]
report_route_status -file [file join $out route_status_post_route.txt]
report_power -file [file join $out power_post_route.txt]
write_checkpoint -force [file join $out cnn_layer_runner_stride_capture_8ns_post_route.dcp]

# Explicitly query the target family.  The endpoint is a DSP CE generated by
# the registered tiled-input-index update; a zero-match result is meaningful
# evidence that the stride-to-CE cone was removed.
set from [get_pins -hierarchical *stride_reg*/C]
set to [get_pins -hierarchical *tiled_input_index_next*/CEC]
set f [open [file join $out target_cone.txt] w]
puts $f "from_count=[llength $from] to_count=[llength $to]"
if {[llength $from] > 0 && [llength $to] > 0} {
    set paths [get_timing_paths -delay_type max -from $from -to $to -max_paths 20 -nworst 20 -sort_by slack]
    puts $f "path_count=[llength $paths]"
    report_timing -delay_type max -from $from -to $to -max_paths 20 -nworst 20 \
        -sort_by slack -path_type full -input_pins -nets -file [file join $out target_cone_maxpaths.txt]
} else {
    puts $f "path_count=0"
}
close $f
exit
